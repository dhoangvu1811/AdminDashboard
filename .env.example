# Admin Dashboard Environment Variables
# Copy this file to .env.local and fill in your values

# ====================================
# API Configuration
# ====================================
# Backend API Base URL (include version path /V1)
NEXT_PUBLIC_API_URL=http://localhost:8017/V1

# ====================================
# Website Configuration
# ====================================
# Admin dashboard URL (used for redirects, etc.)
# NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ====================================
# Feature Flags (Optional)
# ====================================
# Enable/disable developer tools
# NEXT_PUBLIC_DEV_TOOLS=true

# ====================================
# Notes
# ====================================
# - All NEXT_PUBLIC_* variables are exposed to the browser
# - Never put sensitive data in NEXT_PUBLIC_* variables
# - Backend handles authentication and authorization
# - This dashboard should only be accessible to admin/staff users
